const { Pool } = require("pg");
const path = require("path");
const fs = require("fs");
const userPools = new Map();

function getPool(dbName) {
  if (userPools.has(dbName)) {
    return userPools.get(dbName);
  }
  const baseUrl = process.env.DATABASE_URL;
  if (!baseUrl) {
    throw new Error("DATABASE_URL environment variable is not set");
  }
  const urlMatch = baseUrl.match(/^postgresql:\/\/([^:]+):([^@]+)@([^:]+):(\d+)\/(.+)$/);
  if (!urlMatch) {
    throw new Error("Invalid DATABASE_URL format: " + baseUrl);
  }
  const [, user, password, host, port, baseDb] = urlMatch;
  const config = {
    user,
    password,
    host,
    port: parseInt(port),
    database: dbName,
    ssl: process.env.NODE_ENV === "production",
  };
  const pool = new Pool(config);
  userPools.set(dbName, pool);
  return pool;
}

async function query(dbName, text, params) {
  const pool = getPool(dbName);
  return pool.query(text, params);
}

async function adminQuery(text, params) {
  const pool = getPool("admin");
  return pool.query(text, params);
}

function getUserDbName(req) {
  if (!req || !req.user) {
    return "admin";
  }
  return req.user.sub;
}

module.exports = {
  query,
  adminQuery,
  getUserDbName,
  getPool,
  queryBase: (text, params) => {
    const pool = new Pool({ connectionString: process.env.DATABASE_URL });
    return pool.query(text, params).then(() => pool.end()).catch(() => pool.end());
  },
};